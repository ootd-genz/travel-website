# Supabase public configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase credential
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application URL
APP_URL=http://localhost:3000

# Booking defaults
BOOKING_DRAFT_TTL_MINUTES=60
TRANSFER_PROOF_MAX_BYTES=5242880
TRANSFER_PROOF_ALLOWED_TYPES=image/jpeg,image/png,application/pdf

# WhatsApp provider (server-only credentials)
WHATSAPP_PROVIDER=meta_cloud_api
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_ACCESS_TOKEN=your-server-only-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ADMIN_NUMBER=6282261060675
WHATSAPP_TEMPLATE_NAME=booking_waiting_verification
WHATSAPP_TEMPLATE_LANGUAGE=id

# Non-secret business defaults locked in Phase 0
BANK_NAME=BCA
BANK_ACCOUNT_NUMBER=87654321
BANK_ACCOUNT_HOLDER=Muhammad Fulan

# Structured logging and optional server-side error tracking webhook
OBSERVABILITY_SERVICE_NAME=travel-website
OBSERVABILITY_LOG_LEVEL=info
OBSERVABILITY_ERROR_WEBHOOK_URL=
