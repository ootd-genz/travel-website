{
  "name": "travel-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:phase2:static": "node scripts/validate-phase-2.mjs",
    "test:phase3:static": "node scripts/validate-phase-3.mjs",
    "test:phase4:static": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/validate-phase-4.mjs",
    "test:phase5:static": "node scripts/validate-phase-5.mjs",
    "test:phase6": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/validate-phase-6.mjs",
    "test:phase7": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/validate-phase-7.mjs",
    "test:phase8": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/validate-phase-8.mjs",
    "test:phase9": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/validate-phase-9.mjs",
    "test:phase10": "node scripts/validate-phase-10.mjs",
    "test:phase11": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/validate-phase-11.mjs",
    "test:regression": "npm run test:phase2:static && npm run test:phase3:static && npm run test:phase4:static && npm run test:phase5:static && npm run test:phase6 && npm run test:phase7 && npm run test:phase8 && npm run test:phase9 && npm run test:phase10 && npm run test:phase11",
    "test:phase12": "npm run test:regression && node scripts/validate-phase-12.mjs",
    "test:phase12:staging": "node --env-file-if-exists=.env.staging.local scripts/validate-phase-12-staging.mjs",
    "security:scan": "node scripts/scan-secrets.mjs",
    "seed:bali-demo": "node scripts/seed-bali-demo.mjs",
    "setup:admin": "node --env-file=.env.local scripts/setup-single-admin.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:phase12 && npm run security:scan && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
